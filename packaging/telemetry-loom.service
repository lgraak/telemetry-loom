[Unit]
Description=Telemetry Loom local sensor service
After=network.target

[Service]
Type=simple
User=telemetry-loom
Group=telemetry-loom
WorkingDirectory=/opt/telemetry-loom
ExecStart=/opt/telemetry-loom/TelemetryLoom.Service
Restart=on-failure
RestartSec=5s
Environment=DOTNET_ENVIRONMENT=Production
Environment=TelemetryLoom__ConfigPath=/var/lib/telemetry-loom/config.json
Environment=TelemetryLoom__Access__Mode=LocalOnly
Environment=TelemetryLoom__Access__ListenAddress=127.0.0.1
Environment=TelemetryLoom__Access__Port=5198
EnvironmentFile=-/etc/telemetry-loom/telemetry-loom.env
StateDirectory=telemetry-loom
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
