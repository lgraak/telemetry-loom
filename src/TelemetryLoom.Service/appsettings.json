{
  "Hwmon": {
    "RootPath": "/sys/class/hwmon"
  },
  "TelemetryLoom": {
    "Access": {
      "Mode": "LocalOnly",
      "ListenAddress": "127.0.0.1",
      "Port": 5198
    },
    "LiveUpdates": {
      "IntervalMilliseconds": 1000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
